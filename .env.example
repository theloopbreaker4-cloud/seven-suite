# Seven Suite — copy to .env and adjust. Values below match docker/compose.dev.yml.
# Do not set NODE_ENV here: Nx loads this file into every task, and `next build` must run
# with NODE_ENV=production. The server defaults to development when it is unset.


# PostgreSQL: migrations run as the owner; the app connects as the RLS-bound role.
DATABASE_URL=postgresql://seven:seven_dev_password@127.0.0.1:5434/seven_suite
DATABASE_APP_URL=postgresql://seven_app:seven_app_dev_password@127.0.0.1:5434/seven_suite
DATABASE_TEST_URL=postgresql://seven:seven_dev_password@127.0.0.1:5434/seven_suite_test

REDIS_URL=redis://127.0.0.1:6380

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# 64+ random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-before-running-anything-real
# Key the web app uses to call the API server-to-server.
WEB_SERVICE_KEY=change-me-too

# Files (S3-compatible; SeaweedFS in dev)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=seven
S3_SECRET_KEY=seven_dev_password
S3_BUCKET_PUBLIC=seven-public
S3_BUCKET_PRIVATE=seven-private

# Mail (Mailpit in dev: UI at http://localhost:8026)
SMTP_URL=smtp://127.0.0.1:1026
MAIL_FROM="Seven Suite <no-reply@seven.local>"

# Web
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:4000
