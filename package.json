{
  "name": "seven-angular",
  "version": "1.0.0",
  "description": "SevenCMS — Angular 20 + NestJS fullstack CMS",
  "main": "gulpfile.js",
  "private": true,
  "scripts": {
    "move:shared": "gulp move-shared",
    "watch": "gulp watch",
    "nest": "nest",
    "ng": "ng",
    "nest:start": "cd backend && npm run start:dev",
    "nest:build": "cd backend && npm run build",
    "ng:start": "cd frontend && npm run start",
    "ng:build": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "lint": "eslint \"**/*.ts\" --fix"
  },
  "engines": {
    "node": ">=20.0.0 <23",
    "npm": ">=8.0.0"
  },
  "author": {
    "name": "TheLoopBreaker",
    "email": "the.loop.breaker4@gmail.com",
    "url": "https://github.com/theloopbreaker4-cloud"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theloopbreaker4-cloud/seven-angular.git"
  },
  "bugs": {
    "url": "https://github.com/theloopbreaker4-cloud/seven-angular/issues"
  },
  "homepage": "https://github.com/theloopbreaker4-cloud/seven-angular#readme",
  "keywords": [
    "angular",
    "nestjs",
    "fullstack",
    "websocket",
    "jwt",
    "mongodb",
    "typescript",
    "socket.io",
    "real-time",
    "chat",
    "authentication",
    "passport"
  ],
  "devDependencies": {
    "@angular/cli": "^20.0.3",
    "@nestjs/cli": "^11.0.7",
    "@typescript-eslint/eslint-plugin": "^8.22.1",
    "@typescript-eslint/parser": "^8.22.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "gulp": "^5.0.0",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3"
  }
}
