{
  "name": "server-platform",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/platform/src",
  "projectType": "library",
  "tags": ["type:lib", "platform:server", "scope:platform"],
  "// targets": "to see all targets run: nx show project server-platform --web",
  "targets": {
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "libs/server/platform",
        "command": "jest --config jest.int.config.cts --runInBand",
        "env": {
          "TS_NODE_COMPILER_OPTIONS": "{\"moduleResolution\":\"node10\",\"module\":\"commonjs\",\"customConditions\":null}"
        }
      }
    }
  }
}
