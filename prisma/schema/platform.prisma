// Platform kernel: tenants, identities, access, reliable events, audit.
// Tables live in the `platform` PostgreSQL schema. Tenant-owned tables carry org_id and are
// protected by row-level security (see the RLS migration); `user` is global.

model Organization {
  id              String   @id @default(uuid(7)) @db.Uuid
  slug            String   @unique
  name            String
  legalName       String?  @map("legal_name")
  country         String   @default("GE") @db.Char(2)
  baseCurrency    String   @default("GEL") @map("base_currency") @db.Char(3)
  timezone        String   @default("Asia/Tbilisi")
  locale          String   @default("ka")
  languages       String[] @default(["ka", "en", "ru"])
  modulesEnabled  String[] @default(["core"]) @map("modules_enabled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]

  @@map("organization")
  @@schema("platform")
}

model User {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  name           String
  locale         String    @default("en")
  emailVerified  DateTime? @map("email_verified") @db.Timestamptz(3)
  totpSecret     String?   @map("totp_secret")
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("user")
  @@schema("platform")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  key         String
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([orgId, key])
  @@map("role")
  @@schema("platform")
}

model Membership {
  id        String   @id @default(uuid(7)) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
  @@map("membership")
  @@schema("platform")
}

/// Rotating refresh tokens. Only a hash is stored; a reused (already rotated) token revokes
/// its whole family (replay detection).
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_token")
  @@schema("platform")
}

/// Transactional outbox: written in the same transaction as the change it describes,
/// dispatched to queues by the worker.
model OutboxEvent {
  id           String    @id @default(uuid(7)) @db.Uuid
  orgId        String?   @map("org_id") @db.Uuid
  name         String
  payload      Json
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")

  @@index([dispatchedAt, occurredAt])
  @@map("outbox_event")
  @@schema("platform")
}

/// Idempotency record for event consumers: (consumer, event) is processed at most once.
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_event")
  @@schema("platform")
}

/// Append-only change log.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  before     Json?
  after      Json?
  ip         String?
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orgId, entityType, entityId])
  @@map("audit_log")
  @@schema("platform")
}
